soong_namespace {
}

android_app_import {
    name: "UnisocIms",
    apk: "proprietary/system_ext/priv-app/ims/ims.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    required: ["privapp_whitelist_com.spreadtrum.ims"],
}

prebuilt_etc {
    name: "privapp_whitelist_com.spreadtrum.ims",
    src: "proprietary/system_ext/etc/permissions/com.spreadtrum.ims.xml",
    filename: "com.spreadtrum.ims.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libimsbrd",
    target: {
        android_arm: {
            srcs: ["proprietary/system_ext/lib/libimsbrd.so"],
        },
        android_arm64: {
            srcs: ["proprietary/system_ext/lib64/libimsbrd.so"],
        },
    },
    compile_multilib: "both",
    shared_libs: [
        "libc++",
        "libcutils",
        "liblog",
        "libnetlink",
        "libnetutils",
    ],
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

cc_prebuilt_binary {
    name: "ims_bridged",
    srcs: ["proprietary/system_ext/bin/ims_bridged"],
    compile_multilib: "64",
    init_rc: ["proprietary/system_ext/etc/init/ims_bridged.rc"],
    shared_libs: [
        "libc++",
        "libcutils",
        "libimsbrd",
        "liblog",
        "libnetutils",
        "libnl",
    ],
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "vendor.unisoc.frameworks.srmi-V1-ndk",
    target: {
        android_arm: {
            srcs: ["proprietary/system_ext/lib/vendor.unisoc.frameworks.srmi-V1-ndk.so"],
        },
        android_arm64: {
            srcs: ["proprietary/system_ext/lib64/vendor.unisoc.frameworks.srmi-V1-ndk.so"],
        },
    },
    compile_multilib: "both",
    shared_libs: [
        "libbinder_ndk",
        "libc++",
    ],
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libsrmi",
    target: {
        android_arm: {
            srcs: ["proprietary/system_ext/lib/libsrmi.so"],
        },
        android_arm64: {
            srcs: ["proprietary/system_ext/lib64/libsrmi.so"],
        },
    },
    compile_multilib: "both",
    shared_libs: [
        "libc++",
        "libcutils",
        "liblog",
        "libnetutils",
    ],
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

cc_prebuilt_library_shared {
    name: "libsrmiservice",
    target: {
        android_arm: {
            srcs: ["proprietary/system_ext/lib/libsrmiservice.so"],
        },
        android_arm64: {
            srcs: ["proprietary/system_ext/lib64/libsrmiservice.so"],
        },
    },
    compile_multilib: "both",
    shared_libs: [
        "libbinder",
        "libbinder_ndk",
        "libc++",
        "libcutils",
        "liblog",
        "libsrmi",
        "vendor.unisoc.frameworks.srmi-V1-ndk",
    ],
    strip: {
        none: true,
    },
    system_ext_specific: true,
}

cc_prebuilt_binary {
    name: "srmi_proxyd",
    srcs: ["proprietary/system_ext/bin/srmi_proxyd"],
    compile_multilib: "64",
    init_rc: ["proprietary/system_ext/etc/init/srmi_proxyd.rc"],
    shared_libs: [
        "libc++",
        "libcutils",
        "liblog",
        "libnetutils",
        "libsrmi",
        "libsrmiservice",
    ],
    strip: {
        none: true,
    },
    system_ext_specific: true,
}
